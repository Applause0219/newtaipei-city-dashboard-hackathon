AIRFLOW_IMAGE_NAME=taipei-city-dashboard-airflow:2.10.5
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=../../

# Change these before exposing the Airflow UI.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# The local root Docker stack provides postgres-manager and redis on br_dashboard.
# Keep MATADATA_DATABASE for compatibility with the existing compose variable name.
MATADATA_DATABASE=postgresql+psycopg2://postgres:change-me@postgres-manager:5432/dashboardmanager
CELERY_RESULT_BACKEND=db+postgresql://postgres:change-me@postgres-manager:5432/dashboardmanager
REDIS_CONN=redis://redis:6379/0

# Local defaults. Set a stable Fernet key and the public URL in a real deployment.
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_BASE_URL=http://localhost:8080
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_HEALTHCHECK_PATH=/health
_PIP_ADDITIONAL_REQUIREMENTS=
