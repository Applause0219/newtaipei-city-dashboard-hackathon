AIRFLOW_IMAGE_NAME=taipei-city-dashboard-airflow:2.10.5
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=../../

# Replace every placeholder before deploying.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me
MATADATA_DATABASE=postgresql+psycopg2://<db-user>:<db-password>@<db-host>:5432/<db-name>
CELERY_RESULT_BACKEND=db+postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>
REDIS_CONN=redis://airflow-redis:6379/0

# Use a stable generated Fernet key for the lifetime of this Airflow metadata DB.
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_BASE_URL=https://test-citydashboard.taipei/airflow-prod
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_HEALTHCHECK_PATH=/airflow-prod/health
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=
_PIP_ADDITIONAL_REQUIREMENTS=
