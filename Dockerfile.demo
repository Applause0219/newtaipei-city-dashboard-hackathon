FROM node:21-slim

# 安裝 postgresql-client，因 AI 模組 (catalog.js/series.js) 底層依賴 `psql` 指令查詢資料庫
RUN apt-get update && apt-get install -y postgresql-client && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 複製 FE 專案所有檔案
COPY Taipei-City-Dashboard-FE /app

# 安裝依賴套件並進行 Build
RUN npm ci

# 繞過 ESLint 檢查，直接進行 Vite Build (因 local-demo 包含 Node.js 檔案會被 Eslint 阻擋)
RUN npx vite build

EXPOSE 5173

# 透過 vite preview 啟動伺服器 (已支援 inject.js 中介層)
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "5173"]
